{
  "expo": {
    "name": "Rwanda AgriSense",
    "slug": "agrisense-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#F9FBF7"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1B5E20"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow AgriSense to use your location for crop suitability analysis."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow AgriSense to access your photos to set a profile picture."
        }
      ]
    ],
    "scheme": "agrisense",
    "newArchEnabled": true,
    "web": {
      "bundler": "metro"
    },
    "assetBundlePatterns": ["**/*"]
  }
}
