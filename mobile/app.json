{
  "expo": {
    "name": "AgriSense",
    "slug": "agrisense-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash.png",
      "backgroundColor": "#1a4a2e"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1a4a2e"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.tresor26.agrisensemobile"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow AgriSense to use your location for crop suitability analysis."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow AgriSense to access your photos to set a profile picture."
        }
      ]
    ],
    "scheme": "agrisense",
    "newArchEnabled": true,
    "web": {
      "bundler": "metro"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d99c1d90-a832-4c49-af70-f0886e4174c1"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d99c1d90-a832-4c49-af70-f0886e4174c1"
    },
    "ios": {}
  }
}
